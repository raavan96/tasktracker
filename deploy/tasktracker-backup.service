[Unit]
Description=TaskTracker database and attachment backup
After=tasktracker-staging-db.service
Requires=tasktracker-staging-db.service
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/tasktracker-staging/scripts/postgres/backup.py
UMask=0077
Nice=10
IOSchedulingClass=idle
MemoryMax=128M
TimeoutStartSec=240
