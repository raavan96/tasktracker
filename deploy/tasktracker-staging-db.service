[Unit]
Description=Isolated TaskTracker staging PostgreSQL
After=network.target
[Service]
Type=simple
User=postgres
Group=postgres
Slice=tasktracker-staging.slice
ExecStart=/usr/bin/postgres -D /var/lib/pgsql/tasktracker-staging/data
Restart=on-failure
RestartSec=10
MemoryMax=192M
OOMPolicy=stop
TimeoutStopSec=60
KillSignal=SIGINT
# CentOS SELinux requires the PostgreSQL executable domain transition.
# NoNewPrivileges prevents that transition; keep the other sandbox restrictions.
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pgsql/tasktracker-staging
PrivateTmp=true

[Install]
WantedBy=multi-user.target
