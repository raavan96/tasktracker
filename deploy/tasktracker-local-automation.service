[Unit]
Description=TaskTracker local recurring tasks and reminders
After=tasktracker-staging-db.service
Requires=tasktracker-staging-db.service
[Service]
Type=oneshot
User=tasktracker
Group=tasktracker
WorkingDirectory=/opt/tasktracker-staging
EnvironmentFile=/etc/tasktracker-local.env
ExecStart=/usr/bin/node scripts/postgres/automation.mjs
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
MemoryMax=64M
TimeoutStartSec=90
